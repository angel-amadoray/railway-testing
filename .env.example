ENVIRONMENT=development
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]
S3_BUCKET=nasa-irsa-spherex
S3_REGION=us-east-1
LOG_LEVEL=INFO

OCI_ENDPOINT=https://<namespace>.compat.objectstorage.us-ashburn-1.oraclecloud.com
OCI_ACCESS_KEY=<access-key>
OCI_SECRET_KEY=<secret-key>
OCI_BUCKET=space-app-fits
OCI_REGION=us-ashburn-1
OCI_PREFIX=fits
OCI_DOWNLOAD_ENABLED=true